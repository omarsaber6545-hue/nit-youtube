{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/cron/check-socials",
      "schedule": "*/10 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/src/web/public/admin.html"
    },
    {
      "source": "/admin.html",
      "destination": "/src/web/public/admin.html"
    },
    {
      "source": "/css/admin.css",
      "destination": "/src/web/public/css/admin.css"
    },
    {
      "source": "/js/admin.js",
      "destination": "/src/web/public/js/admin.js"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
