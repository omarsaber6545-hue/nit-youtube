{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/admin/socials/:id",
      "destination": "/api/admin/socials?id=:id"
    },
    {
      "source": "/api/admin/announcements/:id",
      "destination": "/api/admin/announcements?id=:id"
    },
    {
      "source": "/api/click/:platform",
      "destination": "/api/click?platform=:platform"
    },
    {
      "source": "/api/analytics/view",
      "destination": "/api/analytics"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
